VERMITHOR_NAME=Vermithor

OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://127.0.0.1:11434

WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

VOICE_ENABLED=true
START_IN_VOICE=true
AUTO_START=true

VOICE_CALIBRATION_SECONDS=0.8

# Wake phrase listening

VOICE_WAKE_MAX_SECONDS=7
VOICE_WAKE_START_TIMEOUT=2.5
VOICE_WAKE_SILENCE_SECONDS=1.2

# Full command listening

VOICE_COMMAND_MAX_SECONDS=12
VOICE_COMMAND_START_TIMEOUT=5
VOICE_COMMAND_SILENCE_SECONDS=1.35

MEMORY_FILE=data/memory.json
